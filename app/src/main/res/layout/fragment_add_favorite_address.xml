<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".AddFavoriteAddressFragment">

    <EditText
        android:id="@+id/edit_text_address_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/add_favorite_address_name_hint"
        android:inputType="text"
        android:autofillHints="name" />

    <EditText
        android:id="@+id/edit_text_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/add_favorite_address_address_hint"
        android:inputType="textPostalAddress"
        android:autofillHints="postalAddress" />

    <Button
        android:id="@+id/button_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="@string/add_favorite_address_save_button" />

</LinearLayout>