<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Night Mode. -->
    <style name="Theme.Garbage_truck" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- ✅ 使用 深綠/活力橘 配色 (夜間模式版本) -->
        <item name="colorPrimary">@color/design_primary_green</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/design_accent_orange</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- 背景、卡片與文字顏色 -->
        <item name="android:windowBackground">@color/black</item> <!-- 最底層背景用純黑 -->
        <item name="colorSurface">@color/design_card_dark</item> <!-- 卡片背景 -->
        <item name="colorOnSurface">@color/design_text_light</item> <!-- 卡片上的文字 -->
        <item name="android:textColor">@color/design_text_light</item> <!-- 一般文字 -->

        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
    </style>
</resources>
