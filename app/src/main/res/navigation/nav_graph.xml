<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.example.garbage_truck.MapFragment"
        android:label="周邊清運點"
        tools:layout="@layout/fragment_map" >
        <argument
            android:name="latitude"
            app:argType="float"
            android:defaultValue="0.0" />
        <argument
            android:name="longitude"
            app:argType="float"
            android:defaultValue="0.0" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.garbage_truck.HomeFragment"
        android:label="垃圾車清運查詢"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_mapFragment"
            app:destination="@id/mapFragment" />
    </fragment>

    <fragment
        android:id="@+id/classificationFragment"
        android:name="com.example.garbage_truck.ClassificationFragment"
        android:label="垃圾分類輔助"
        tools:layout="@layout/fragment_classification" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.garbage_truck.SettingsFragment"
        android:label="設定"
        tools:layout="@layout/fragment_settings" >
        <action
            android:id="@+id/action_settingsFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.garbage_truck.LoginFragment"
        android:label="登入"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@+id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.garbage_truck.RegisterFragment"
        android:label="註冊"
        tools:layout="@layout/fragment_register" />

</navigation>